<resources>
    <style name="Theme.KidClock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="Theme.KidClock.Settings" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="colorAccent">@color/accent</item>
        <!-- Framework dialogs (sound chooser, weather location) would otherwise be light with our light text. -->
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
    </style>
</resources>
